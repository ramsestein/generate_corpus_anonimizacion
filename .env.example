# Configuración del LLM para el juez de entidades
# Copia este archivo a .env y completa con tus credenciales reales

# API Key del proveedor de LLM
LLM_API_KEY=your_api_key_here

# URL del endpoint de la API (formato ChatCompletion)
# Ejemplos:
# - OpenAI: https://api.openai.com/v1/chat/completions
# - Claude: https://api.anthropic.com/v1/messages
# - Mistral: https://api.mistral.ai/v1/chat/completions
# - Azure OpenAI: https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT/chat/completions?api-version=2023-05-15
LLM_API_URL=https://api.openai.com/v1/chat/completions

# Nombre del modelo a utilizar
# Ejemplos:
# - OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# - Claude: claude-3-opus-20240229, claude-3-sonnet-20240229
# - Mistral: mistral-large-latest, mistral-medium-latest
LLM_MODEL_NAME=gpt-4o

# Configuración opcional: timeout en segundos
LLM_TIMEOUT=60

# Configuración opcional: temperatura del modelo (0.0 - 1.0)
LLM_TEMPERATURE=0.0
